mkdir ~/jacoco-test
cd ~/jacoco-test

cat > CoverageTest.java <<EOF
package com.mithra.shop;

public class CoverageTest {
    public static void main(String[] args) {
        System.out.println(">>> Hello from AWS JaCoCo Test");
    }
}
EOF


mkdir -p classes
javac -d classes CoverageTest.java
jar cf coverage-test.jar -C classes .


java -Djacoco-agent.verbose=true \
-javaagent:/home/ec2-user/jacocoagent.jar="destfile=/home/ec2-user/jacoco.exec,includes=com/mithra/shop/*" \
-cp coverage-test.jar com.mithra.shop.CoverageTest
